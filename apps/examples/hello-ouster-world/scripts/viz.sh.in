#!@runtimeShell@
set -euo pipefail
export PYTHONPATH="@pythonPath@${PYTHONPATH:+:$PYTHONPATH}"
export SSL_CERT_FILE="${SSL_CERT_FILE:-@caBundlePath@}"
export GLFW_PLATFORM=wayland
export GLFW_WAYLAND_APP_ID=@vizAppId@
export __GL_SYNC_TO_VBLANK=1
unset DISPLAY 2>/dev/null || true
echo "@name@: starting SimpleViz (GLFW Wayland)" >&2
@pythonEnv@/bin/python3 @pythonEntrypoint@ "$@"
