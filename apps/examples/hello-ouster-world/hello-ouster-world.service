[Unit]
Description=hello-ouster-world (MC Console/Display API)
Documentation=file:///usr/lib/teka/mission-control/manifest.json
# Screencopy nvvidconv + nvjpegenc. cuda (not wayland) so the generator does not
# Conflicts= the display compositor. Do not BindReadOnlyPaths=/run/opengl-driver.
X-Teka-PortableGPU=cuda
After=mission-control.service systemd-user-sessions.service network.target network-online.target time-sync.target seatd.service
Wants=network-online.target time-sync.target seatd.service
@appBackendUnitLines@

[Service]
@appNotifyServiceLines@
User=root
@serviceFragment@
Environment=HELLO_OUSTER_WORLD_VIZ=@runLoop@
Environment=HELLO_OUSTER_WORLD_PATH=@clientPath@
Environment=HELLO_OUSTER_WORLD_XDG_RUNTIME_DIR=/run/hello-ouster-world
Environment=HELLO_OUSTER_WORLD_WAYLAND_DISPLAY=wayland-1
Environment=HELLO_OUSTER_WORLD_SWAYMSG=@swaymsg@
Environment=HELLO_OUSTER_WORLD_WTYPE=@wtype@
Environment=HELLO_OUSTER_WORLD_CONSOLE_LOG=/run/hello-ouster-world/console.log
Environment=MC_SENSORS_APP_ID=sensors
Environment=STATE_DIRECTORY=/var/lib/hello-ouster-world
Environment=APP_ID=hello-ouster-world
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-bundle.crt
Environment=RUST_LOG=info
ExecStart=@api@
SyslogIdentifier=hello-ouster-world
Restart=always
RestartSec=3
PrivateDevices=no
SupplementaryGroups=tty seat video render
@hostEtcBindPaths@
BindReadOnlyPaths=-/run/seatd.sock
# Bind the parent so the app can create /srv/recordings.
BindPaths=/srv
RuntimeDirectory=hello-ouster-world
RuntimeDirectoryMode=0700
StateDirectory=hello-ouster-world
StateDirectoryMode=0750
@appBackendServiceLines@

[Install]
WantedBy=teka-apps.target
