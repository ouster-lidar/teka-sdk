#!@bash@/bin/bash
set -euo pipefail

@wlrootsPortableWaylandEnv@

log() { echo "hello-wayland-gpu: $*" >&2; }

if [[ -r /etc/fonts/fonts.conf ]]; then
  export FONTCONFIG_FILE=/etc/fonts/fonts.conf
  export FONTCONFIG_PATH=/etc/fonts
fi

log "starting Sway (--unsupported-gpu)"
exec sway --config @swayConfig@ --unsupported-gpu
