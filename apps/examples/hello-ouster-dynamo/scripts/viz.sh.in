#!@runtimeShell@
set -euo pipefail
export PYTHONPATH="/usr/lib/hello-ouster-dynamo:/usr/lib/hello-ouster-dynamo/dynamo-utils${PYTHONPATH:+:$PYTHONPATH}"
export SSL_CERT_FILE="${SSL_CERT_FILE:-@caBundlePath@}"
export GLFW_PLATFORM=wayland
export GLFW_WAYLAND_APP_ID=hello-ouster-dynamo
export __GL_SYNC_TO_VBLANK=1
unset DISPLAY 2>/dev/null || true
echo "hello-ouster-dynamo: starting SimpleViz (GLFW Wayland)" >&2
@pythonEnv@/bin/python3 /usr/lib/hello-ouster-dynamo/hello_ouster_dynamo.py "$@"
