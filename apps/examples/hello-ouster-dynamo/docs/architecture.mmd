flowchart TB
    subgraph device ["Device"]
        direction LR
        subgraph dyn ["Dynamo"]
            direction TB
            SRC["Source (Live/OSF)"] --> |"LiDAR FrameSets"|PROC["Processing"] --> |"LiDAR FrameSets</br>+ objects"|TXFS["TX"]
        end
        OSF["OSF File"] --> SRC

        subgraph dynamo_viewer ["H-O-D"]
            direction LR
            RXFS["RX"] --> SV["SimpleViz"] --> SWAY["Sway"]
	    HODSC["Source Config</br>/var/lib/hello-ouster-dynamo/source-config.json"]
            SWAY --> NVJPG["nvjpeg encoder"]
        end

        TXFS -->|"IPC<br/>/run/ouster-dynamo/frameset.sock"| RXFS
        HODSC -->|"HTTP POST</br>api/v1/app/ouster-dynamo/source-config"| SRC

        subgraph peripherals ["Local Peripherals"]
            MONITOR["Display Monitor"]
            MKBD["Mouse &<br/>Keyboard"]
        end
    end

    subgraph remote ["Remote"]
        BR["Browser"]
    end

    LIDAR["LiDAR"] --> SRC
    SWAY -->|"HDMI"| MONITOR
    MKBD --> SV
    NVJPG -->|"WebSocket"| BR
    BR -->|"HTTP POST</br>/api/v1/app/hello-ouster-dynamo/source_config"| HODSC
    BR -->|"WS JSON: mouse / keys"| SV

    style dyn stroke-dasharray: 5 5
    style dynamo_viewer stroke-dasharray: 5 5
